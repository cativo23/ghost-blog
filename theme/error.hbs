{{!< default}}

<main class="container">
    <div class="error-page">
        <div class="crumb" style="margin-bottom:36px;justify-content:center;">
            <span class="crumb-label">Error</span>
            <span style="color:var(--border-accent)">›</span>
            <span class="crumb-value">{{statusCode}}</span>
        </div>

        <div class="error-content">
            <h1 class="error-code">{{statusCode}}</h1>
            <p class="error-message">{{message}}</p>

            <div class="error-output">
                No such file or directory
            </div>

            <div class="error-actions">
                <a href="{{@site.url}}" class="btn">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    Home
                </a>
                <button class="btn" id="search-trigger-error">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    Search
                </button>
            </div>
        </div>
    </div>
</main>

<style>
.error-page { max-width:600px; margin:80px auto; text-align:center; }
.error-content { display:flex; flex-direction:column; gap:24px; align-items:center; }
.error-code {
    font-family:var(--font-title);
    font-size:96px;
    font-weight:900;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:var(--nw-red);
    text-shadow:0 0 24px rgba(255,102,136,0.4);
    line-height:1;
}
.error-message { font-size:16px; color:var(--text-secondary); font-family:var(--font-sys); }
.error-output {
    padding:14px 20px;
    background:var(--void-panel);
    border:1px solid var(--border-primary);
    border-left:2px solid var(--nw-red-dim);
    font-family:var(--font-sys);
    font-size:13px;
    color:var(--text-muted);
    width:100%;
    text-align:left;
}
.error-actions { display:flex; gap:10px; }
@media(max-width:768px){
    .error-code { font-size:64px; }
    .error-actions { flex-direction:column; width:100%; }
}
</style>

<script>
document.getElementById('search-trigger-error')?.addEventListener('click', () => {
    document.getElementById('search-btn')?.click();
});
</script>
