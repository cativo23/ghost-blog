<!DOCTYPE html>
<html lang="en" data-intensity="archive">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Noto+Serif+Display:wght@700;900&family=Saira+Extra+Condensed:wght@600;700&family=Shippori+Mincho+B1:wght@800&display=swap">

    <link rel="stylesheet" href="{{asset "css/nightwire.css"}}">
    <link rel="stylesheet" href="{{asset "css/tokens.css"}}">
    <link rel="stylesheet" href="{{asset "css/ghost-cards.css"}}">
    <link rel="stylesheet" href="{{asset "css/main.css"}}">
    {{#is "post, page"}}
    <link rel="stylesheet" href="{{asset "css/post.css"}}">
    <link rel="stylesheet" href="{{asset "css/syntax.css"}}">
    {{/is}}

    {{ghost_head}}
</head>
<body class="{{body_class}}">
    <div class="site-wrapper">
        {{> header}}

        <main class="site-content">
            {{{body}}}
        </main>

        {{> footer}}
    </div>

    {{> search-modal}}

    <script src="{{asset "js/main.js"}}"></script>
    {{#is "post"}}
    <script src="{{asset "js/toc.js"}}"></script>
    <script src="{{asset "js/code-blocks.js"}}"></script>
    <script src="{{asset "js/progress.js"}}"></script>
    <script src="{{asset "js/series.js"}}"></script>
    {{/is}}
    <script src="{{asset "js/search.js"}}"></script>

    {{ghost_foot}}
</body>
</html>
