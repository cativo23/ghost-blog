{{!< default}}

<section class="homepage">
    {{!-- Hero Featured Post --}}
    <section class="hero-section">
        {{#get "posts" limit="1" order="featured desc, published_at desc" include="tags,authors"}}
            {{#foreach posts}}
                {{> post-card}}
            {{/foreach}}
        {{/get}}
    </section>

    {{!-- Feed Panel --}}
    <div class="section-rule" style="margin-top: 40px;">
        <span class="led"></span>
        TRANSMISSION LOG
    </div>

    <section class="feed panel">
        <div class="panel-header">
            <span class="panel-header-label">
                <span class="led led--green"></span>
                All Posts
            </span>
            <span class="panel-header-meta">sorted by date</span>
        </div>
        <div class="feed-header">
            <span class="feed-col feed-col--date">date</span>
            <span class="feed-col feed-col--title">title</span>
            <span class="feed-col feed-col--tags">tags</span>
            <span class="feed-col feed-col--time">read</span>
        </div>
        <div class="feed-list">
            {{#foreach posts}}
                {{> terminal-feed-row}}
            {{/foreach}}
        </div>
    </section>

    {{!-- Metric Grid --}}
    <div class="stats-grid">
        {{#get "posts" limit="all"}}
        <div class="stat-item">
            <span class="stat-label">Total Posts</span>
            <span class="stat-value mono">{{pagination.total}}</span>
        </div>
        {{/get}}
        {{#get "tags" limit="all"}}
        <div class="stat-item">
            <span class="stat-label">Tags</span>
            <span class="stat-value mono">{{pagination.total}}</span>
        </div>
        {{/get}}
        <div class="stat-item">
            <span class="stat-label">Avg Read</span>
            <span class="stat-value mono">~5m</span>
        </div>
        <div class="stat-item">
            <span class="stat-label">Since</span>
            <span class="stat-value mono">2026</span>
        </div>
    </div>

    {{!-- Pagination --}}
    {{> pagination}}
</section>
