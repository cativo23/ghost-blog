{{!< default}}

{{#post}}
<main class="container">
    <article class="page-content">
        <div class="crumb" style="margin-bottom:28px;">
            <span class="crumb-label">Pages</span>
            <span style="color:var(--border-accent)">›</span>
            <span class="crumb-value">{{slug}}</span>
        </div>

        {{#unless @page.show_title_and_feature_image}}
        <header class="page-header">
            <h1 class="page-title">{{title}}</h1>
        </header>
        {{/unless}}

        <div class="page-body post-content">
            {{{content}}}
        </div>
    </article>
</main>

<style>
.page-content { max-width: 800px; margin: 0 auto; padding: 40px 0; }
.page-header { margin-bottom: 36px; }
.page-title {
    font-family: var(--font-title);
    font-size: 32px;
    font-weight: 900;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.1;
}
.page-body { max-width: 720px; }
</style>
{{/post}}
