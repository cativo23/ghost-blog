{{!< default}}

<main class="container">
    <div class="tag-header" style="margin-bottom:40px;">
        <div class="crumb" style="margin-bottom:16px;">
            <span class="crumb-label">Tags</span>
            <span style="color:var(--border-accent)">›</span>
            <span class="crumb-value">{{tag.slug}}</span>
        </div>
        <h1 class="tag-title">#{{tag.name}}</h1>
        {{#if tag.description}}
        <p class="tag-description text-muted" style="margin-top:10px;font-size:14px;line-height:1.6;">{{tag.description}}</p>
        {{/if}}
        <div class="tag-count" style="margin-top:10px;font-family:var(--font-stamp);font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--nw-primary);">
            <span class="led led--green"></span>
            {{plural pagination.total empty='No posts' singular='% post' plural='% posts'}}
        </div>
    </div>

    <div class="posts-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;">
        {{#foreach posts}}
        <article class="post-card card">
            {{#if feature_image}}
            <a href="{{url}}" class="post-card-image" style="display:block;overflow:hidden;height:160px;">
                <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" style="width:100%;height:100%;object-fit:cover;filter:saturate(0.85);">
            </a>
            {{/if}}
            <div class="post-card-content" style="padding:16px;display:flex;flex-direction:column;gap:8px;">
                <div class="tag-pills">
                    {{#foreach tags limit="2"}}
                    <a href="{{url}}" class="tag-pill">#{{slug}}</a>
                    {{/foreach}}
                </div>
                <h2 class="post-card-title" style="font-size:15px;font-weight:600;line-height:1.3;">
                    <a href="{{url}}" style="color:inherit;">{{title}}</a>
                </h2>
                <p class="text-muted" style="font-size:13px;line-height:1.5;">{{excerpt words="20"}}</p>
                <div style="display:flex;gap:8px;align-items:center;font-family:var(--font-sys);font-size:12px;color:var(--text-muted);">
                    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM DD, YYYY"}}</time>
                    <span>&middot;</span>
                    <span>{{reading_time}} min</span>
                </div>
            </div>
        </article>
        {{/foreach}}
    </div>

    {{pagination}}
</main>
