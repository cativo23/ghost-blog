<div class="search-overlay" id="search-overlay" aria-hidden="true">
    <div class="search-modal">
        <div class="search-modal-header">
            <span class="search-modal-title">
                <span class="led"></span>
                Search
            </span>
            <button class="search-close nav-btn" id="search-close" aria-label="Close search">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>
        <div class="search-input-wrapper">
            <span class="search-input-prefix">query</span>
            <input type="text" id="search-input" class="search-input" placeholder="search posts..." autocomplete="off" aria-label="Search posts">
        </div>
        <div class="search-results" id="search-results"></div>
        <div class="search-footer">
            <span class="text-muted" id="search-stats"></span>
        </div>
    </div>
</div>
