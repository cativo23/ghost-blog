<a href="{{url}}" class="feed-row">
    <span class="feed-col feed-col--date">{{date format="MMM DD"}}</span>
    <span class="feed-col feed-col--title">
        <span class="feed-title">{{title}}</span>
        {{#foreach tags visibility="internal"}}
          {{#match slug "~" "series-"}}
            <span class="feed-series-badge">{{name}}</span>
          {{/match}}
        {{/foreach}}
    </span>
    <span class="feed-col feed-col--tags">
        {{#foreach tags limit="2"}}
        <span class="tag-pill">{{name}}</span>
        {{/foreach}}
    </span>
    <span class="feed-col feed-col--time">{{reading_time}}m</span>
</a>
